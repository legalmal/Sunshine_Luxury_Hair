rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /orders/{orderId} {
      // Customers can submit checkout orders without creating an account.
      allow create: if true;
      allow read, update, delete: if isSignedIn();
    }

    match /messages/{messageId} {
      allow create: if request.resource.data.keys().hasAll([
          'name', 'email', 'subject', 'message', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'subject', 'message', 'status', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 254
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 150
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 3000
        && request.resource.data.status == 'received'
        && request.resource.data.createdAt == request.time;

      allow read: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    match /settings/{settingId} {
      // Storefront contact, currency, and delivery details are public client settings.
      allow read: if settingId == 'storefront';
      // Match the existing admin write policy used for products and order management.
      allow create, update, delete: if isSignedIn();
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /orders/{orderId} {
      // Customers can submit checkout orders without creating an account.
      allow create: if true;
      allow read, update, delete: if isSignedIn();
    }

    match /messages/{messageId} {
      allow create: if request.resource.data.keys().hasAll([
          'name', 'email', 'subject', 'message', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'subject', 'message', 'status', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 254
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 150
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 3000
        && request.resource.data.status == 'received'
        && request.resource.data.createdAt == request.time;

      allow read: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    match /favorites/{favoriteId} {
      // Visitors can save one favorite state per product and browser identity.
      // Dashboard reads remain restricted to signed-in administrators.
      allow read: if isSignedIn();
      allow create, update: if request.resource.data.keys().hasAll([
          'productId', 'visitorId', 'liked', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'productId', 'visitorId', 'liked', 'updatedAt'
        ])
        && request.resource.data.productId is string
        && request.resource.data.productId.size() > 0
        && request.resource.data.productId.size() <= 500
        && request.resource.data.visitorId is string
        && request.resource.data.visitorId.matches('^[a-zA-Z0-9-]{1,80}$')
        && request.resource.data.liked is bool
        && request.resource.data.updatedAt == request.time
        && favoriteId == request.resource.data.productId + '_' + request.resource.data.visitorId;
      allow delete: if false;
    }

    match /settings/{settingId} {
      // Storefront contact, currency, and delivery details are public client settings.
      // Admin notification settings contain the private recipient address.
      allow read: if settingId == 'storefront'
        || (settingId == 'adminNotifications' && isSignedIn());
      // Match the existing admin write policy used for products and order management.
      allow create, update, delete: if isSignedIn();
    }
  }
}
